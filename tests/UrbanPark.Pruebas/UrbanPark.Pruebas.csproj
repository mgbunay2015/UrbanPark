<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UrbanPark.Pruebas</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
  <!-- La API solo tiene net10.0; al recompilar la solución MAUI VS pasa net10.0-maccatalyst y rompía CS0006. -->
    <ProjectReference Include="..\..\UrbanPark.Api\UrbanPark.Api.csproj">
      <SetTargetFramework>TargetFramework=net10.0</SetTargetFramework>
    </ProjectReference>
  </ItemGroup>

</Project>
