<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UrbanPark.App.Views.vQrPuesto"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Fondo}"
             Title="Mi QR">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ================= encabezado ================= -->
        <VerticalStackLayout Grid.Row="0" Padding="14,12,14,4" Spacing="1">
            <Label x:Name="lblTituloQr"
                   Text="Tu puesto está reservado"
                   Style="{StaticResource TituloPagina}" />
            <Label x:Name="lblSubtitulo"
                   Text="Muestra este QR en la entrada del parqueadero"
                   Style="{StaticResource SubtituloPagina}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14,4,14,10" Spacing="10">

                <!-- ================= ticket del cliente (igual al físico) ================= -->
                <Border x:Name="panelTicket"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8"
                        Padding="0">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,4" Radius="14" Opacity="0.45" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="0">

                        <!-- flecha roja de la cabecera -->
                        <Path Data="M 0,26 L 80,0 L 160,26 Z"
                              Fill="#D8232A"
                              Aspect="Fill"
                              HeightRequest="15"
                              HorizontalOptions="Fill" />

                        <!-- cabecera: número, fecha y placa a la izquierda · entrada y hora a la derecha -->
                        <Grid Padding="13,7,13,0"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                            <VerticalStackLayout Spacing="0">
                                <Label x:Name="lblTicketNumero"
                                       Text="N: 0000000"
                                       FontFamily="monospace"
                                       FontSize="11"
                                       TextColor="#111827"
                                       LineBreakMode="NoWrap" />
                                <Label x:Name="lblTicketFecha"
                                       Text="00/00/0000"
                                       FontFamily="monospace"
                                       FontSize="11"
                                       TextColor="#111827"
                                       LineBreakMode="NoWrap" />
                                <Label x:Name="lblTicketPlaca"
                                       Text="ABC1234"
                                       FontFamily="monospace"
                                       FontAttributes="Bold"
                                       FontSize="12"
                                       CharacterSpacing="1"
                                       TextColor="#111827"
                                       LineBreakMode="NoWrap" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="0">
                                <Label x:Name="lblTicketEntrada"
                                       Text="E: 000"
                                       FontFamily="monospace"
                                       FontSize="11"
                                       TextColor="#111827"
                                       HorizontalTextAlignment="End"
                                       LineBreakMode="NoWrap" />
                                <Label x:Name="lblTicketHora"
                                       Text="00:00"
                                       FontFamily="monospace"
                                       FontSize="11"
                                       TextColor="#111827"
                                       HorizontalTextAlignment="End"
                                       LineBreakMode="NoWrap" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- QR centrado, con aire alrededor como en el ticket impreso -->
                        <Grid Padding="0,12,0,14" HorizontalOptions="Center">
                            <Image x:Name="imgQr"
                                   WidthRequest="208"
                                   HeightRequest="208"
                                   Aspect="AspectFit" />
                        </Grid>

                        <!-- pie: sede, logo y aviso -->
                        <BoxView HeightRequest="1" Color="#E5E7EB" Margin="13,0" />

                        <Grid Padding="13,8,13,11"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                            <VerticalStackLayout Spacing="3">
                                <Label x:Name="lblTicketSede"
                                       Text="URBAN PARK"
                                       FontFamily="monospace"
                                       FontSize="11"
                                       CharacterSpacing="0.5"
                                       TextColor="#111827"
                                       LineBreakMode="TailTruncation" />

                                <HorizontalStackLayout Spacing="5">
                                    <Border BackgroundColor="#D8232A"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 9"
                                            WidthRequest="18"
                                            HeightRequest="18"
                                            Padding="0"
                                            VerticalOptions="Center">
                                        <Label Text="U"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="11"
                                               TextColor="White"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>

                                    <Label VerticalOptions="Center" FontSize="13" FontFamily="OpenSansSemibold">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Urba" TextColor="#1D4ED8" />
                                                <Span Text="Park" TextColor="#D8232A" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="0"
                                                 VerticalOptions="Center"
                                                 HorizontalOptions="End">
                                <Label Text="FAVOR VER"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="8"
                                       CharacterSpacing="0.4"
                                       TextColor="#D8232A"
                                       HorizontalTextAlignment="End" />
                                <Label Text="AL REVERSO →"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="8"
                                       CharacterSpacing="0.4"
                                       TextColor="#D8232A"
                                       HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label x:Name="lblDireccion"
                       FontSize="10"
                       TextColor="{StaticResource TextoClaroSuave}"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap" />

                <!-- ================= valor a pagar ================= -->
                <Border x:Name="panelValor"
                        BackgroundColor="{StaticResource Superficie}"
                        Stroke="{StaticResource Acento}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="12,8">
                    <VerticalStackLayout Spacing="1">
                        <Label x:Name="lblEtiquetaMonto"
                               Text="VALOR A PAGAR EN ESTE MOMENTO"
                               Style="{StaticResource EncabezadoTabla}"
                               HorizontalTextAlignment="Center" />
                        <Label x:Name="lblMonto"
                               Text="$0.00"
                               FontFamily="OpenSansSemibold"
                               FontSize="32"
                               TextColor="{StaticResource Acento}"
                               HorizontalTextAlignment="Center" />
                        <Label x:Name="lblTiempo"
                               Text="00:00:00 dentro"
                               FontSize="12"
                               TextColor="{StaticResource TextoClaroMedio}"
                               HorizontalTextAlignment="Center" />
                        <Label x:Name="lblCalculo"
                               FontSize="10"
                               TextColor="{StaticResource TextoClaroSuave}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- ================= datos del pase ================= -->
                <Border BackgroundColor="{StaticResource Superficie}"
                        Stroke="{StaticResource SuperficieBorde}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="12">
                    <VerticalStackLayout x:Name="contenidoDatos" Spacing="4" />
                </Border>

                <Label x:Name="lblNota"
                       FontSize="10"
                       TextColor="{StaticResource TextoClaroSuave}"
                       Text="El QR lleva el parqueadero, la dirección, el puesto, la placa y el valor de ahora. Se actualiza solo mientras la reserva siga activa."
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- ================= acciones ================= -->
        <VerticalStackLayout Grid.Row="2" Padding="12,6,12,10" Spacing="6"
                             BackgroundColor="{StaticResource Superficie}">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button x:Name="btnLlegar"
                        Text="🗺 Cómo llegar"
                        Clicked="OnLlegarClicked"
                        Style="{StaticResource BotonFantasma}"
                        FontSize="12"
                        HeightRequest="38" />
                <Button x:Name="btnPagar"
                        Grid.Column="1"
                        Text="Cerrar y pagar"
                        Clicked="OnPagarClicked"
                        Style="{StaticResource BotonAcento}"
                        FontSize="12"
                        HeightRequest="38" />
            </Grid>
            <Button x:Name="btnAnular"
                    Text="Anular la reserva y liberar el puesto"
                    Clicked="OnAnularClicked"
                    Style="{StaticResource BotonFantasma}"
                    TextColor="{StaticResource Peligro}"
                    FontSize="11"
                    HeightRequest="32" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
