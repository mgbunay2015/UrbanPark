<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UrbanPark.App.Views.vRegistro"
             Title="Registro"
             BackgroundColor="{StaticResource Fondo}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="12" RowSpacing="8">

        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Text="Registro de la app"
                   Style="{StaticResource TituloSeccion}" />
            <Label x:Name="lblResumen"
                   Style="{StaticResource TextoSecundario}"
                   FontSize="11"
                   LineBreakMode="WordWrap" />
        </VerticalStackLayout>

        <!-- El texto va en un Editor de solo lectura: se puede seleccionar y copiar. -->
        <Border Grid.Row="1"
                Style="{StaticResource TarjetaClara}">
            <Editor x:Name="txtRegistro"
                    IsReadOnly="True"
                    FontSize="10"
                    FontFamily="OpenSansRegular"
                    TextColor="{StaticResource TextoFuerte}"
                    BackgroundColor="Transparent"
                    AutoSize="Disabled" />
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <Button Text="Actualizar"
                    Clicked="OnActualizarClicked"
                    Style="{StaticResource BotonPrimario}"
                    HeightRequest="38"
                    FontSize="11" />
            <Button Grid.Column="1"
                    Text="Copiar"
                    Clicked="OnCopiarClicked"
                    Style="{StaticResource BotonAcento}"
                    HeightRequest="38"
                    FontSize="11" />
            <Button Grid.Column="2"
                    Text="Borrar"
                    Clicked="OnBorrarClicked"
                    Style="{StaticResource BotonContornoMarca}"
                    HeightRequest="38"
                    FontSize="11" />
        </Grid>
    </Grid>
</ContentPage>
