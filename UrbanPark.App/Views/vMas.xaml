<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UrbanPark.App.Views.vMas"
             Shell.NavBarIsVisible="False"
             Title="Más">

    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="6">
            <Label Text="Más" Style="{StaticResource TituloPagina}" />
            <Label Text="Plazas, tickets y el resto de Urban Park."
                   Style="{StaticResource SubtituloPagina}" />
            <VerticalStackLayout x:Name="lista" Spacing="8" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
