<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UrbanPark.App.Views.vTarifas"
             Title="Cambiar precios">

    <ScrollView>
        <VerticalStackLayout Padding="10,10,10,16" Spacing="8" MaximumWidthRequest="680">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Precios masivos" Style="{StaticResource TituloPagina}" />
                    <Label Text="Rango oficial: $0.50 – $0.90 por hora. Solo ADMIN."
                           Style="{StaticResource SubtituloPagina}" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="↻"
                        Clicked="OnActualizarClicked"
                        Style="{StaticResource BotonSecundario}"
                        FontSize="15"
                        HeightRequest="38"
                        WidthRequest="42"
                        Padding="0"
                        VerticalOptions="Center" />
            </Grid>

            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="PARQUEADEROS" Style="{StaticResource TituloSeccionClaro}" />
                    <Label x:Name="lblSedes"
                           Text="Todas las sedes"
                           Style="{StaticResource TextoSuave}"
                           FontSize="10" />
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout x:Name="filaSedes" Spacing="6" />
                    </ScrollView>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="REGLA DE CAMBIO" Style="{StaticResource TituloSeccionClaro}" />

                    <Label Text="Modo" Style="{StaticResource EtiquetaCampoClaro}" />
                    <Picker x:Name="pickerModo"
                            Title="Elige el modo"
                            SelectedIndexChanged="OnModoChanged" />
                    <Label x:Name="lblModoAyuda"
                           Text="Ej.: 10 sube un 10 %; -5 baja un 5 %."
                           FontSize="10"
                           TextColor="{StaticResource TextoSuave}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Valor" Style="{StaticResource EtiquetaCampoClaro}" />
                            <Border Style="{StaticResource CampoOscuro}">
                                <Entry x:Name="txtValor"
                                       Keyboard="Numeric"
                                       Placeholder="10 o 0.70"
                                       Style="{StaticResource FechaOscura}" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Zona (opcional)" Style="{StaticResource EtiquetaCampoClaro}" />
                            <Border Style="{StaticResource CampoOscuro}">
                                <Picker x:Name="pickerZona" Title="Todas" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Tipo de plaza (opcional)" Style="{StaticResource EtiquetaCampoClaro}" />
                        <Border Style="{StaticResource CampoOscuro}">
                            <Picker x:Name="pickerTipo" Title="Todos" />
                        </Border>
                    </VerticalStackLayout>

                    <Button x:Name="btnAplicar"
                            Text="Aplicar cambio masivo"
                            Clicked="OnAplicarClicked"
                            Style="{StaticResource BotonPrimario}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="TARIFAS ACTUALES" Style="{StaticResource TituloSeccionClaro}" />
                    <VerticalStackLayout x:Name="listaResumen" Spacing="6" />
                    <ActivityIndicator x:Name="spinner"
                                       IsRunning="False"
                                       IsVisible="False"
                                       Color="{StaticResource Acento}" />
                </VerticalStackLayout>
            </Border>

            <Label x:Name="lblPie"
                   FontSize="11"
                   TextColor="{StaticResource TextoSuave}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
