<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UrbanPark.App.Views.vRegistrados"
             Title="Registrados">

    <Grid Padding="10,10,10,12" RowDefinitions="Auto,*" RowSpacing="8">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                <Label x:Name="lblTitulo" Text="Registrados" Style="{StaticResource TituloPagina}" />
                <Label Text="Vehículos registrados. Dar de baja los desactiva, no los borra."
                       Style="{StaticResource SubtituloPagina}" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="Registrar"
                    Clicked="OnRegistrarClicked"
                    Style="{StaticResource BotonPrimario}"
                    VerticalOptions="Center"
                    HeightRequest="32"
                    Padding="10,0" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="10">
                <ActivityIndicator x:Name="spinner" IsRunning="False" IsVisible="False" HorizontalOptions="Start" />
                <VerticalStackLayout x:Name="contenedorVehiculos" Spacing="0" />
            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
